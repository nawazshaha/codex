export interface SearchEmptyState {
  completed: boolean;
  resultCount: number;
}

/** Gate the search-empty placement without coupling it to search retrieval. */
export function shouldShowSearchEmptyRecommendations(
  search: SearchEmptyState,
): boolean {
  return search.completed && search.resultCount === 0;
}

