/**
 * Module 06, Sprint 1: placement discovery and UX contract.
 *
 * This file captures the agreed discovery baseline before connecting to the
 * recommendation API. Keep search retrieval separate: the search-empty rail
 * is shown only after the catalogue search itself has completed with no hits.
 */

export type RecommendationPlacement =
  | "home"
  | "product_detail"
  | "category"
  | "search_empty"
  | "cart";

export type FallbackBehavior =
  | "hide_section"
  | "show_catalogue_popular"
  | "show_category_popular"
  | "show_related_products"
  | "keep_cart_unchanged";

export interface PlacementDefinition {
  /** User-facing location where the recommendation rail belongs. */
  label: string;
  /** Context fields the page can provide when requesting recommendations. */
  requiredContext: readonly string[];
  /** Fallback when the API returns no items. */
  emptyFallback: FallbackBehavior;
  /** Fallback on timeout or request error. */
  errorFallback: FallbackBehavior;
  /** UX constraints to carry into design and implementation stories. */
  uxNotes: readonly string[];
}

